{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "integration_baseline.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "baseline_id",
    "status",
    "program_issue",
    "program_bundle_url",
    "program_bundle_sha256",
    "source_pull_request",
    "previous_main_sha",
    "subject_head_sha",
    "merge_commit_sha",
    "expected_parent_shas",
    "expected_tree_sha",
    "frozen_pr11_head_sha",
    "merged_at",
    "verified_at",
    "successful_exact_head_runs"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "baseline_id": {
      "type": "string",
      "pattern": "[a-z0-9_]+"
    },
    "status": {
      "type": "string",
      "const": "FROZEN_BASELINE"
    },
    "program_issue": {
      "type": "integer",
      "const": 18
    },
    "program_bundle_url": {
      "type": "string",
      "pattern": "https://github\\.com/dddd2024/reverse-agent/issues/18#issuecomment-[0-9]+"
    },
    "program_bundle_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "source_pull_request": {
      "type": "integer",
      "const": 9
    },
    "previous_main_sha": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "subject_head_sha": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "merge_commit_sha": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "expected_parent_shas": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "[0-9a-f]{40}"
      }
    },
    "expected_tree_sha": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "frozen_pr11_head_sha": {
      "type": "string",
      "pattern": "[0-9a-f]{40}"
    },
    "merged_at": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "verified_at": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z"
    },
    "successful_exact_head_runs": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "run_id",
          "head_sha",
          "conclusion",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "enum": [
              "CI",
              "Decision Preflight",
              "State Gate (pull_request)",
              "State Gate (push)"
            ]
          },
          "run_id": {
            "type": "integer"
          },
          "head_sha": {
            "type": "string",
            "pattern": "[0-9a-f]{40}"
          },
          "conclusion": {
            "type": "string",
            "const": "success"
          },
          "url": {
            "type": "string",
            "pattern": "https://github\\.com/dddd2024/reverse-agent/actions/runs/[0-9]+"
          }
        }
      }
    }
  }
}
