{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "merge_approval_attestation.schema.json",
  "title": "Merge approval attestation",
  "description": "External merge approval attestation created only after final exact-head CI succeeds. Stored outside the PR Git tree (GitHub PR comment or Actions artifact). Binds repository, source PR, locked base, accepted exact head, verified workflow run IDs, human approver identity, content digest, and expiry/supersession. Verified by RemoteAcceptanceVerifier against the GitHub API (Issue #23, v3 architecture B).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attestation_id",
    "repository",
    "source_pr",
    "locked_base_sha",
    "accepted_exact_head_sha",
    "workflow_observations",
    "human_r2_approval",
    "content_digest",
    "authorization_status",
    "expires_at",
    "superseded_by",
    "attested_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "attestation_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "pattern": "^[^/]+/[^/]+$"},
    "source_pr": {"type": "integer", "minimum": 1},
    "locked_base_sha": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "accepted_exact_head_sha": {"type": "string", "pattern": "[0-9a-f]{40}"},
    "workflow_observations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "run_id", "workflow_file", "event", "run_attempt", "conclusion", "head_sha"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "run_id": {"type": "integer", "minimum": 1},
          "workflow_file": {"type": "string", "minLength": 1},
          "event": {"type": "string", "minLength": 1},
          "run_attempt": {"type": "integer", "minimum": 1},
          "conclusion": {"type": "string", "const": "success"},
          "head_sha": {"type": "string", "pattern": "[0-9a-f]{40}"}
        }
      }
    },
    "human_r2_approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approver", "approval_object_id", "approval_content_digest"],
      "properties": {
        "approver": {"type": "string", "minLength": 1},
        "approval_object_id": {"type": "string", "minLength": 1},
        "approval_content_digest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"}
      }
    },
    "content_digest": {"type": "string", "pattern": "sha256:[0-9a-f]{64}"},
    "authorization_status": {"type": "string", "enum": ["active", "expired", "superseded"]},
    "expires_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "superseded_by": {"type": ["string", "null"]},
    "attested_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}
  }
}
