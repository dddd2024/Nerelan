+        elif report_status == "TEMPLATE_ONLY":
+            errors.append("codex_report_summary is TEMPLATE_ONLY")
+        else:
+            errors.append("codex_report_summary missing")
+    if not report_id:
+        errors.append("report_id missing")
+    if not round_id:
