+                    .replace(microsecond=0)
+                    .isoformat()
+                    .replace("+00:00", "Z")
+                    if path.exists()
+                    else None
+                ),
+                "source": "case_result.artifact_manifest",
+                "freshness": _artifact_freshness(path, reports_dir=reports_dir, latest_run=latest_run),
+            }
+        )
