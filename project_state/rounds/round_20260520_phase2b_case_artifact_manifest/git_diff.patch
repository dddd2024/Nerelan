+            continue
+        latest_artifact_paths[kind] = path
+        recent_artifacts.append(
+            {
+                "kind": kind,
+                "path": _path_for_json(path),
+                "size_bytes": path.stat().st_size if path.exists() else None,
+                "modified_at": (
