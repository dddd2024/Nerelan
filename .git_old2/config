[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[branch "main"]
	vscode-merge-base = origin/main
	remote = origin
	merge = refs/heads/main
[extensions]
	worktreeConfig = true
[branch "codex/merge-dynamic-model"]
	vscode-merge-base = origin/main
[remote "origin"]
	url = https://github.com/dddd2024/reverse-agent.git
	fetch = +refs/heads/*:refs/remotes/origin/*
