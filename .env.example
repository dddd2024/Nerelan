# reverse-agent environment variables
# Copy this file to .env and fill in the values for your environment.

# Path to OllyDbg executable (required for single-step debugging backend)
# Example: C:\Tools\OllyDbg\ollydbg.exe
REVERSE_AGENT_OLLYDBG_PATH=

# Path to the target sample binary (required for runtime probing)
# Example: F:\reverse-agent\samples\samplereverse.exe
REVERSE_AGENT_SAMPLE_PATH=

# ---------------------------------------------------------------------------
# Multi-account orchestration (domain A-E)
#
# Everything below is OFF unless REVERSE_AGENT_MULTI_ACCOUNT_ENABLED=1. With the
# master switch unset, dispatch behaves exactly as it did before this surface
# existed: no timed window, no cost gate, no alert drain, no learning feedback.
#
# Only placeholders are listed here. Never put a provider credential, token or
# account password in this file: the orchestration brain never reads credentials
# and stores account identity as a hash only.
# ---------------------------------------------------------------------------

# Master switch. 1 = perceive accounts, schedule, learn, enforce the limits below.
REVERSE_AGENT_MULTI_ACCOUNT_ENABLED=

# Magpie loopback base URL (default http://127.0.0.1:3425). The desktop app serves
# quota snapshots and usage aggregates over HTTP and ships no CLI; only a loopback
# origin is accepted, and no credential is ever read from here.
REVERSE_AGENT_MAGPIE_URL=

# Optional CLI for per-request cost rows. Without it the cost basis falls back to
# HTTP aggregates (real totals, errors and latency, but no per-task attribution
# and no cash/subscription split).
REVERSE_AGENT_MAGPIE_EXE=

# Local ledger (spend, cooldowns, scores, policy versions, run clock).
# Default: <runtime dir>/multi_account.json
REVERSE_AGENT_MULTI_ACCOUNT_STORE=

# Who owns account selection: local | magpie | auto.
# auto delegates to Magpie only when REVERSE_AGENT_MAGPIE=1 *and*
# REVERSE_AGENT_MAGPIE_ACCOUNT_SWITCHING=1 (both locks required).
REVERSE_AGENT_ACCOUNT_ROUTING=

# --- perception and freshness ---------------------------------------------
# Seconds before an observation is treated as STALE (default 1800). It must
# match how often your provider actually re-reads: Magpie re-reads on demand, so
# a 600 s budget emptied a healthy eleven-account pool within half an hour.
REVERSE_AGENT_MULTI_ACCOUNT_FRESHNESS=
# Magpie snapshot max age (default 2400, must be >= freshness).
REVERSE_AGENT_MULTI_ACCOUNT_MAGPIE_MAX_AGE=
# used_percent at which an account is DEGRADED (default 90).
REVERSE_AGENT_MULTI_ACCOUNT_HIGH_UTILIZATION=
# Window resetting within this many seconds is flagged reset_soon (default 1800).
REVERSE_AGENT_MULTI_ACCOUNT_RESET_SOON_SECONDS=
# Largest task p80 allowed on a STALE/DEGRADED account (default 1.0).
REVERSE_AGENT_MULTI_ACCOUNT_SMALL_TASK_CEILING=

# --- switching, isolation and retry ---------------------------------------
# Max accounts one task may be moved across before dead-letter (default 3).
REVERSE_AGENT_MULTI_ACCOUNT_REROUTE_ATTEMPTS=
# Quiet period for an account after a reroute, seconds (default 30).
REVERSE_AGENT_MULTI_ACCOUNT_REROUTE_COOLDOWN=
# Quarantine period for an unhealthy account, seconds (default 300).
REVERSE_AGENT_MULTI_ACCOUNT_ABNORMAL_COOLDOWN=
# Quarantine a task after its reroute budget, keeping evidence (default true).
REVERSE_AGENT_MULTI_ACCOUNT_DEAD_LETTER=
# Exponential backoff for a failing account: first step, factor, ceiling.
REVERSE_AGENT_MULTI_ACCOUNT_BACKOFF_BASE=
REVERSE_AGENT_MULTI_ACCOUNT_BACKOFF_MULTIPLIER=
REVERSE_AGENT_MULTI_ACCOUNT_BACKOFF_MAX=
# How long a failure streak is remembered, seconds (default 21600).
REVERSE_AGENT_MULTI_ACCOUNT_COOLDOWN_MEMORY=
# Persist cooldowns/quarantine across restarts (default true).
REVERSE_AGENT_MULTI_ACCOUNT_PERSIST_STATE=
# Heartbeat interval for a hibernating host, seconds (default 60).
REVERSE_AGENT_MULTI_ACCOUNT_STANDBY_KEEPALIVE=

# --- measured feedback and self-evolution ---------------------------------
# Learn per-account reliability/cost/latency (default true).
REVERSE_AGENT_MULTI_ACCOUNT_SCORING=
# EWMA smoothing for the scores, 0<alpha<1 (default 0.25).
REVERSE_AGENT_MULTI_ACCOUNT_SCORE_ALPHA=
# Headroom-equivalent points a 0->1 change may move (defaults 12 / 10 / 5).
REVERSE_AGENT_MULTI_ACCOUNT_RELIABILITY_WEIGHT=
REVERSE_AGENT_MULTI_ACCOUNT_COST_WEIGHT=
REVERSE_AGENT_MULTI_ACCOUNT_LATENCY_WEIGHT=
# Bounded run ledger (default 500) so a long run cannot grow without limit.
REVERSE_AGENT_MULTI_ACCOUNT_MAX_RECORDED_RUNS=
# Persist and feed the break-even recommendation (default true).
REVERSE_AGENT_MULTI_ACCOUNT_SELF_EVOLUTION=
REVERSE_AGENT_MULTI_ACCOUNT_MIN_MODE_OBSERVATIONS=
# Feed measured usage into delta_calibration (default true).
REVERSE_AGENT_MULTI_ACCOUNT_CALIBRATION_FEEDBACK=

# --- cost ceiling ----------------------------------------------------------
# Enforced ceiling per rolling window. Enabling it REQUIRES a positive cap,
# otherwise startup fails rather than denying every attempt.
REVERSE_AGENT_MULTI_ACCOUNT_COST_BUDGET=
REVERSE_AGENT_MULTI_ACCOUNT_COST_BUDGET_UNITS=
# Rolling window length in seconds (default 86400).
REVERSE_AGENT_MULTI_ACCOUNT_COST_BUDGET_WINDOW=
# Soft ratio at which dispatch prefers the cheapest account (default 0.8).
REVERSE_AGENT_MULTI_ACCOUNT_COST_BUDGET_SOFT_RATIO=
# Conservative forecast per attempt when no estimate exists (0 = judge on spend).
REVERSE_AGENT_MULTI_ACCOUNT_COST_BUDGET_TASK_UNITS=
# Count in-flight reservations against the ceiling (default true).
REVERSE_AGENT_MULTI_ACCOUNT_COST_BUDGET_RESERVATIONS=

# --- alerting --------------------------------------------------------------
REVERSE_AGENT_MULTI_ACCOUNT_ALERTS=
# Same (code, subject) is not re-paged within this many seconds (default 300).
REVERSE_AGENT_MULTI_ACCOUNT_ALERT_QUIET=
# Bounded alert history (default 120).
REVERSE_AGENT_MULTI_ACCOUNT_ALERT_MAX_HISTORY=
# Flapping / unreliable-account thresholds (defaults 2 / 0.6 / 3).
REVERSE_AGENT_MULTI_ACCOUNT_ALERT_STREAK=
REVERSE_AGENT_MULTI_ACCOUNT_ALERT_MIN_SUCCESS=
REVERSE_AGENT_MULTI_ACCOUNT_ALERT_MIN_SAMPLES=
# Also write alerts to the reverse_agent.multi_account log (default false).
REVERSE_AGENT_MULTI_ACCOUNT_ALERT_LOG=

# --- run duration ----------------------------------------------------------
REVERSE_AGENT_MULTI_ACCOUNT_WATCHDOG=
# Wall-clock budget of one run, seconds. 0 = unlimited (default).
REVERSE_AGENT_MULTI_ACCOUNT_MAX_RUN_SECONDS=
# Conclude after no completed attempt for this long. 0 = unlimited (default).
REVERSE_AGENT_MULTI_ACCOUNT_MAX_IDLE_SECONDS=
# Past this multiple of the budget, conclude escalates to stop (default 1.25).
REVERSE_AGENT_MULTI_ACCOUNT_HARD_STOP_RATIO=

# --- self-evolution policy clamps (auditable, rollback-able) ---------------
REVERSE_AGENT_MULTI_ACCOUNT_POLICY=
# Largest single weight change per evaluation, as a fraction (default 0.25).
REVERSE_AGENT_MULTI_ACCOUNT_POLICY_STEP=
# Total drift allowed from the configured baseline, fraction (default 0.5).
REVERSE_AGENT_MULTI_ACCOUNT_POLICY_DRIFT=
# Hard cap on learned ranking bonus points (default 12).
REVERSE_AGENT_MULTI_ACCOUNT_POLICY_MAX_BONUS=
# Evidence required before a policy step (default 5).
REVERSE_AGENT_MULTI_ACCOUNT_POLICY_MIN_SAMPLES=
# Success rate the loop steers toward (default 0.85).
REVERSE_AGENT_MULTI_ACCOUNT_POLICY_TARGET_SUCCESS=
# Bounded audit trail length (default 120).
REVERSE_AGENT_MULTI_ACCOUNT_POLICY_AUDIT_ENTRIES=
