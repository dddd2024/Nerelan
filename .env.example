# reverse-agent environment variables
# Copy this file to .env and fill in the values for your environment.

# Path to OllyDbg executable (required for single-step debugging backend)
# Example: C:\Tools\OllyDbg\ollydbg.exe
REVERSE_AGENT_OLLYDBG_PATH=

# Path to the target sample binary (required for runtime probing)
# Example: F:\reverse-agent\samples\samplereverse.exe
REVERSE_AGENT_SAMPLE_PATH=
