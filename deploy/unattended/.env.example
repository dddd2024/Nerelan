# Copy to .env outside version control and set every value before `up`.
POSTGRES_PASSWORD=
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Non-secret path to a temporary 0600 file outside the repository.
UNATTENDED_OPENAI_API_KEY_FILE=/tmp/reverse-agent-openai-api-key

# Non-secret local endpoints and bounded workspace settings.
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_NAMESPACE=default
LITELLM_BASE_URL=http://litellm:4000/v1
UNATTENDED_WORKSPACE_ROOT=../../.var/unattended
UNATTENDED_BIND_ADDRESS=127.0.0.1
